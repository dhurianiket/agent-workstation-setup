# ==============================================================================
# Agent Workstation Configuration (.env)
# Copy this file to .env and customize with your own credentials or profiles.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS Bedrock Credentials (Default / AWS Startup Credits)
# ------------------------------------------------------------------------------
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# ------------------------------------------------------------------------------
# 2. Bring-Your-Own-Keys (BYOK) - For users without AWS
# ------------------------------------------------------------------------------
# OpenRouter (Access 100+ models with 1 key: Claude 3.5, DeepSeek R1, Llama 3.3)
# OPENROUTER_API_KEY=sk-or-v1-...

# NVIDIA NIM (Access Llama 3.3 70B, DeepSeek R1, Kimi)
# NVIDIA_API_KEY=nvapi-...

# DeepSeek API Direct
# DEEPSEEK_API_KEY=sk-...

# Groq Cloud Direct (Ultra-fast Llama & DeepSeek distill)
# GROQ_API_KEY=gsk_...

# OpenAI Direct
# OPENAI_API_KEY=sk-proj-...

# ------------------------------------------------------------------------------
# 3. Local GPU Engine (Ollama - Free & 100% Offline)
# ------------------------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# ------------------------------------------------------------------------------
# 4. Gateway Server Settings
# ------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
