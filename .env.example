# ==============================================================================
# Agent Workstation Configuration (.env)
# Copy this file to .env and customize with your own credentials or profiles.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS Bedrock Credentials (Recommended for AWS Startup Credits / Cloud)
# ------------------------------------------------------------------------------
# Set your AWS profile name if you use AWS CLI profiles (e.g., ~/.aws/credentials)
AWS_PROFILE=default

# AWS Region where your Bedrock models are provisioned (default: us-east-1)
AWS_DEFAULT_REGION=us-east-1

# Optional: Direct AWS IAM credentials (if not using AWS CLI profiles)
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# ------------------------------------------------------------------------------
# 2. Local GPU Engine (Ollama - Free & Offline)
# ------------------------------------------------------------------------------
# Ollama service endpoint (runs on Mac Metal GPU or PC AMD/NVIDIA GPU)
OLLAMA_HOST=http://127.0.0.1:11434

# Baseline local model to use for $0 tasks
OLLAMA_MODEL=llama3.2:1b

# ------------------------------------------------------------------------------
# 3. Gateway Server Settings
# ------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
