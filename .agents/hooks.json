{
  "workstation-auto-router": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./tools/pre_invocation_hook.py --session-start || python ./tools/pre_invocation_hook.py --session-start",
        "timeout": 15
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./tools/pre_invocation_hook.py || python ./tools/pre_invocation_hook.py",
        "timeout": 15
      }
    ]
  }
}
